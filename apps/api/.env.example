# API configuration template. Copy to apps/api/.env for local development.
NODE_ENV=development
API_PORT=4000
API_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27018/storyhaven?replicaSet=storyhaven
TEST_MONGODB_URI=mongodb://127.0.0.1:27018/storyhaven_test?replicaSet=storyhaven
MEDIA_DIR=../../.local/uploads
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Cloudinary: server-side only. Set MEDIA_STORAGE=cloudinary after filling all three values.
MEDIA_STORAGE=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Vercel only: generate a random secret of at least 32 characters.
CRON_SECRET=
