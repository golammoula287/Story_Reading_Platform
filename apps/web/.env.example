# Web configuration template. Copy to apps/web/.env.local for local development.
API_INTERNAL_URL=http://127.0.0.1:4000
# Vercel can deploy the frontend first with this unset or still localhost.
# API features remain unavailable until you set the hosted backend URL and redeploy.
NEXT_PUBLIC_SITE_NAME=Storyhaven
# Optional: override Vercel's production domain for a custom/staging frontend.
# Must match the backend WEB_ORIGIN. Generated Vercel aliases redirect here.
# CANONICAL_WEB_ORIGIN=https://your-frontend.vercel.app

# On Render set API_INTERNAL_URL to the backend HTTPS origin before building.
# See docs/DEPLOYMENT_RENDER.md; local env files do not configure the dashboard.
# For both apps on Vercel, see docs/DEPLOYMENT_VERCEL.md.
