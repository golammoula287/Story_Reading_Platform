{
  "name": "@storyhaven/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx src/workers/publishing.ts",
    "build": "node ../../scripts/build-api.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx src/scripts/seed.ts",
    "admin:create": "tsx src/scripts/create-admin.ts",
    "worker:start": "node dist/workers/publishing.js"
  },
  "dependencies": {
    "@storyhaven/contracts": "*",
    "express": "5.2.1",
    "mongoose": "9.10.2",
    "zod": "4.6.5",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.3",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "google-auth-library": "11.1.0",
    "multer": "2.4.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/cookie-parser": "1.4.10",
    "@types/multer": "2.2.0",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "vitest": "5.0.1"
  }
}
